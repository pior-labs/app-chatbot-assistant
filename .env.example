# Application identity
APP_SLUG=assistant
COMPOSE_PROJECT_NAME=assistant
API_PORT=3000
WEB_PORT=5173
# Use an existing local PostgreSQL server; create an isolated assistant_dev DB.
DATABASE_URL=postgresql://assistant_dev:replace-with-local-db-password@localhost:5432/assistant_dev
# Optional API-in-Docker connection to that existing local server.
DOCKER_DATABASE_URL=

# Hosted central SSO. Secrets below are API-only, never VITE_*.
CENTRAL_AUTH_ISSUER=https://auth.szarans.ca/api/auth
CENTRAL_AUTH_CLIENT_ID=assistant
CENTRAL_AUTH_CLIENT_SECRET=replace-with-registered-assistant-client-secret
# Generate a separate random secret (at least 32 characters).
BETTER_AUTH_SECRET=replace-with-independent-application-session-secret
BETTER_AUTH_URL=http://localhost:5173

# Production: set BETTER_AUTH_URL=https://chat.szarans.ca and mount this file.
PLATFORM_DATABASE_URL_FILE=/opt/docker/pior-labs/secrets/app-chatbot-assistant/database-url
