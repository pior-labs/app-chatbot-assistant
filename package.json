{
  "name": "pior-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @assistant/api --filter @assistant/web dev",
    "dev:api": "pnpm --filter @assistant/api dev",
    "dev:web": "pnpm --filter @assistant/web dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck && tsc -p tsconfig.tools.json",
    "db:generate": "pnpm --filter @assistant/api db:generate",
    "db:migrate": "pnpm --filter @assistant/api db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm --filter @assistant/api test",
    "test:browser": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm test:browser"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
